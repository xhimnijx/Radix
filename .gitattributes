# Keep text files LF in the repository regardless of the developer's autocrlf.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1  text eol=crlf

*.pdf  binary
*.png  binary
*.dll  binary
*.exe  binary
*.rlib binary

# Scripts and unit files must be LF even when committed from Windows
*.sh text eol=lf
*.service text eol=lf
