    given-names: "Maxim"
repository-code: "https://github.com/xhimnijx/Radix"
keywords:
  - post-quantum cryptography
  - lattice cryptography
  - ring signatures
  - zero knowledge
  - privacy
  - cryptocurrency
references:
  - type: article
    title: "SMILE: Set Membership from Ideal Lattices with Applications to Ring Signatures and Confidential Transactions"
    authors:
      - family-names: "Del Pino"
        given-names: "Rafael"
      - family-names: "Katsumata"
        given-names: "Shuichi"
      - family-names: "Prest"
        given-names: "Thomas"
    year: 2021
    url: "https://eprint.iacr.org/2021/564"
    notes: "The protocol this repository implements. Note the e1 term erratum recorded in REVIEW-FINDINGS.md."
